root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120
# The official Kotlin style, the same one Android Studio formats with.
ktlint_code_style = intellij_idea
# Composable functions are named like types: LampMark, PixroostPlaceholder.
ktlint_function_naming_ignore_when_annotated_with = Composable
# Don't split short accessor chains such as libs.plugins.pixroost.compose.get().pluginId.
ktlint_chain_method_rule_force_multiline_when_chain_operator_count_greater_or_equal_than = unset
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ij_kotlin_imports_layout = *,java.**,javax.**,kotlin.**,^

[*.{yml,yaml,json,toml,xml}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.swift]
indent_size = 4

[{*.bat,*.cmd,*.ps1}]
end_of_line = crlf
